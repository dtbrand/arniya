<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Security: Disable directory browsing
    Options -Indexes

    # 1. Canonical 301 Redirects: /home, /home.php, /index.php to clean root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(home|home\.php|index\.php)\ HTTP/ [NC]
    RewriteRule ^(home|home\.php|index\.php)$ / [R=301,L]

    # 2. Clean Product Routes: /product/3 or /product/3/ or /product/slug
    RewriteRule ^product/([0-9]+)/?$ product.php?id=$1 [QSA,L]
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ product.php?slug=$1 [QSA,L]

    # 3. Main Storefront Clean Routes
    RewriteRule ^shop/?$ shop.php [QSA,L]
    RewriteRule ^wholesale/?$ wholesale.php [QSA,L]
    RewriteRule ^reseller/?$ reseller.php [QSA,L]
    RewriteRule ^retailer/?$ retailer.php [QSA,L]
    RewriteRule ^account/?$ account.php [QSA,L]
    RewriteRule ^admin/?$ admin/index.php [QSA,L]

    # 4. Clean Extensionless PHP URL fallback
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [QSA,L]
</IfModule>

# ── 5. Gzip & Deflate Compression (Ultra-Fast Response) ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 6. Smart Browser Asset Caching (30 Days) ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ── 7. Performance & Security Headers ──
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
