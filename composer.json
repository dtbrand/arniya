{
    "name": "dtbrand/arniya",
    "description": "DT Brand's & Jai Hanuman Tex — Luxury Ethnic B2B & Wholesale Commerce Platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "DT Brand's Engineering",
            "email": "admin@jaihanumantex.in"
        }
    ],
    "require": {
        "php": ">=8.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "DTBrand\\": "src/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DTBrand\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
