# ==============================================================================
# DT BRAND'S & JAI HANUMAN TEX — ENTERPRISE ROOT APACHE .HTACCESS
# Version: 3.2 Unified Single-Tree Production Hardened & Legacy 301 Auto-Redirects
# ==============================================================================

Options -Indexes -MultiViews

# ── 1. SECURITY: BLOCK SENSITIVE FILE EXTENSIONS & DOTFILES ──
<FilesMatch "(?i)\.(env.*|git.*|json|lock|neon|xml|sql|md|yml|yaml|log|bak|swp|dist|phar|cache)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── 2. REWRITE ENGINE & URL ROUTING ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to internal protected directories
    RewriteRule ^(config|database|src|app|storage|tests|scripts|vendor|bootstrap|docs|backups|\.git|\.agents|\.uix|\.vscode)/ - [F,L,NC]

    # ── 3. CANONICAL HOMEPAGE REDIRECTS ──
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(home|home\.php|index\.php)\ HTTP/ [NC]
    RewriteRule ^(home|home\.php|index\.php)$ / [R=301,L]

    # ── 4. LEGACY TREE 301 PERMANENT REDIRECTS (Frontend & DT Brand to Root) ──
    # Legacy Single-Product / Single Product PDP
    RewriteRule ^Frontend/Single-Product/(?:singleproduct\.php)?$ /product.php [R=301,QSA,L,NC]
    RewriteRule ^singleproduct(?:\.php)?$ /product.php [R=301,QSA,L,NC]

    # Legacy Shop
    RewriteRule ^Frontend/Shop/(?:shop\.php)?$ /shop.php [R=301,QSA,L,NC]

    # Legacy Home
    RewriteRule ^Frontend/Home/(?:home\.php|index\.php)?$ / [R=301,QSA,L,NC]

    # Legacy Wholesale
    RewriteRule ^Frontend/Wholesale/(?:wholesale\.php)?$ /wholesale.php [R=301,QSA,L,NC]

    # Legacy Reseller
    RewriteRule ^Frontend/Reseller/(?:reseller\.php)?$ /reseller.php [R=301,QSA,L,NC]

    # Legacy Retailer
    RewriteRule ^Frontend/Retailer/(?:retailer\.php)?$ /retailer.php [R=301,QSA,L,NC]

    # Legacy Admin Tree
    RewriteRule ^Frontend/Admin/(.*)$ /admin/$1 [R=301,QSA,L,NC]

    # Legacy DT Brand Tree
    RewriteRule ^DT(?:\ |%20)?Brand/(.*)$ /$1 [R=301,QSA,L,NC]

    # Legacy Frontend Asset Routes
    RewriteRule ^Frontend/[^/]+/Asset/images/(.*)$ /assets/images/$1 [R=301,L,NC]
    RewriteRule ^Frontend/[^/]+/Asset/css/(.*)$ /assets/css/$1 [R=301,L,NC]
    RewriteRule ^Frontend/[^/]+/Asset/js/(.*)$ /assets/js/$1 [R=301,L,NC]

    # Admin Asset & Includes Case-Insensitive Aliases
    RewriteRule ^admin/Asset/(.*)$ admin/assets/$1 [L,NC]
    RewriteRule ^admin/Includes/(.*)$ admin/includes/$1 [L,NC]

    # ── 5. STOREFRONT CLEAN URL ROUTING (.php optional / pretty URLs) ──
    # Product PDP
    RewriteRule ^product/?$ product.php [QSA,L]
    RewriteRule ^product/([0-9]+)/?$ product.php?id=$1 [QSA,L]
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ product.php?slug=$1 [QSA,L]

    # Main Portals
    RewriteRule ^shop/?$ shop.php [QSA,L]
    RewriteRule ^wholesale/?$ wholesale.php [QSA,L]
    RewriteRule ^reseller/?$ reseller.php [QSA,L]
    RewriteRule ^retailer/?$ retailer.php [QSA,L]
    RewriteRule ^account/?$ account.php [QSA,L]
    RewriteRule ^cart/?$ cart.php [QSA,L]
    RewriteRule ^checkout/?$ checkout.php [QSA,L]
    RewriteRule ^wishlist/?$ wishlist.php [QSA,L]
    RewriteRule ^about-us/?$ about-us.php [QSA,L]
    RewriteRule ^privacy/?$ privacy.php [QSA,L]
    RewriteRule ^shipping/?$ shipping.php [QSA,L]
    RewriteRule ^terms/?$ terms.php [QSA,L]
    RewriteRule ^logout/?$ logout.php [QSA,L]
    RewriteRule ^health/?$ health.php [QSA,L]

    # ── 6. CLEAN API ROUTES ──
    RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ api/$1.php [QSA,L]

    # ── 7. CLEAN ADMIN & AUTH ROUTES ──
    RewriteRule ^admin/login/?$ adminlogin.php [QSA,L]
    RewriteRule ^adminlogin/?$ adminlogin.php [QSA,L]
    RewriteRule ^login/?$ adminlogin.php [QSA,L]
    RewriteRule ^admin/?$ admin/index.php [QSA,L]

    # Admin Subroutes
    RewriteRule ^admin/products/?$ admin/products/index.php [QSA,L]
    RewriteRule ^admin/products/([^/]+\.php)$ admin/products/$1 [QSA,L]
    RewriteRule ^admin/products/([^/]+)/?$ admin/products/$1/index.php [QSA,L]
    RewriteRule ^admin/products/([^/]+)/([^/]+\.php)$ admin/products/$1/$2 [QSA,L]

    RewriteRule ^admin/([^/]+)/?$ admin/$1/index.php [QSA,L]
    RewriteRule ^admin/([^/]+)/([^/]+\.php)$ admin/$1/$2 [QSA,L]
</IfModule>

# ── 8. ENTERPRISE SECURITY HEADERS ──
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
