<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Canonical Redirects: /home, /home.php, /index.php to clean root domain https://jaihanumantex.in/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(home|home\.php|index\.php)\ HTTP/ [NC]
    RewriteRule ^(home|home\.php|index\.php)$ / [R=301,L]

    # 2. Allow direct access to DT Brand
    RewriteCond %{REQUEST_URI} ^/DT\ Brand/ [NC]
    RewriteRule ^ - [L]

    # 3. Clean Product Routes: /product/3 or /product/slug
    RewriteRule ^product/([0-9]+)/?$ DT\ Brand/product.php?id=$1 [QSA,L]
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ DT\ Brand/product.php?slug=$1 [QSA,L]

    # 4. Main Storefront Clean Routes
    RewriteRule ^shop/?$ DT\ Brand/shop.php [QSA,L]
    RewriteRule ^wholesale/?$ DT\ Brand/wholesale.php [QSA,L]
    RewriteRule ^reseller/?$ DT\ Brand/reseller.php [QSA,L]
    RewriteRule ^retailer/?$ DT\ Brand/retailer.php [QSA,L]
    RewriteRule ^account/?$ DT\ Brand/account.php [QSA,L]

    # 5. Clean Admin & Auth Routes
    RewriteRule ^admin/login/?$ DT\ Brand/admin/login.php [QSA,L]
    RewriteRule ^adminlogin/?$ DT\ Brand/admin/login.php [QSA,L]
    RewriteRule ^login/?$ DT\ Brand/admin/login.php [QSA,L]
    RewriteRule ^admin/?$ DT\ Brand/admin/index.php [QSA,L]

    # Admin Subroutes
    RewriteRule ^admin/products/?$ DT\ Brand/admin/products/index.php [QSA,L]
    RewriteRule ^admin/products/([^/]+\.php)$ DT\ Brand/admin/products/$1 [QSA,L]
    RewriteRule ^admin/products/([^/]+)/?$ DT\ Brand/admin/products/$1/index.php [QSA,L]
    RewriteRule ^admin/products/([^/]+)/([^/]+\.php)$ DT\ Brand/admin/products/$1/$2 [QSA,L]

    RewriteRule ^admin/([^/]+)/?$ DT\ Brand/admin/$1/index.php [QSA,L]
    RewriteRule ^admin/([^/]+)/([^/]+\.php)$ DT\ Brand/admin/$1/$2 [QSA,L]

    # 6. Route all other root requests to DT Brand subfolder seamlessly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/DT\ Brand/ [NC]
    RewriteRule ^(.*)$ DT\ Brand/$1 [L,QSA]
</IfModule>
