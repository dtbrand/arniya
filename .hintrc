{
    "extends": [
        "development"
    ],
    "hints": {
        "compat-api/css": [
            "default",
            {
                "ignore": [
                    "-webkit-overflow-scrolling",
                    "-webkit-user-drag",
                    "scrollbar-width",
                    "scrollbar-color",
                    "backdrop-filter",
                    "user-select"
                ]
            }
        ]
    }
}