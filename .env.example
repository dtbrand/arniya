# DT Brand's & Jai Hanuman Tex — Production Environment
# Copy this file to `.env` on the server and fill in the real values.
# This file MUST NOT be committed (see .gitignore).

# ───────────── Application ─────────────
APP_NAME="DT Brand's (Jai Hanuman Tex)"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://jaihanumantex.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en_IN
APP_CURRENCY=INR

# ───────────── Database (MySQL / MariaDB) ─────────────
# Production: Hostinger Business MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u602484543_demodt121
DB_USER=u602484543_demodt121
DB_PASS=Gautam@9006

# ───────────── Session ─────────────
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

# ───────────── Mailer (SMTP) ─────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@jaihanumantex.in
MAIL_PASSWORD=replace_with_hostinger_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@jaihanumantex.in
MAIL_FROM_NAME="DT Brand's"

# ───────────── Payment Gateway (Razorpay) ─────────────
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_with_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ───────────── Logistics & Couriers ─────────────
DELHIVERY_API_TOKEN=replace_with_delhivery_token
BLUEDART_CLIENT_ID=replace_with_bluedart_id
BLUEDART_CLIENT_SECRET=replace_with_bluedart_secret
TCI_ACCOUNT_ID=replace_with_tci_account_id

# ───────────── Meta WhatsApp Cloud API ─────────────
WHATSAPP_PHONE_ID=replace_with_phone_id
WHATSAPP_WABA_ID=replace_with_waba_id
WHATSAPP_ACCESS_TOKEN=replace_with_access_token
WHATSAPP_VERIFY_TOKEN=replace_with_verify_token
# Brand master contact used in every product/share/WhatsApp link.
WHATSAPP_MASTER_PHONE=917046363528

# ───────────── Observability ─────────────
SENTRY_DSN=

# ───────────── Feature flags ─────────────
DT_ENABLE_ADMIN_GUARD=true
DT_ENABLE_API_GUARD=true
DT_ENABLE_WEBHOOK_SIGNING=true

# ───────────── Channel WhatsApp Numbers ─────────────
# Optional per-channel routing. Falls back to WHATSAPP_MASTER_PHONE.
WHATSAPP_RETAIL_PHONE=
WHATSAPP_WHOLESALE_PHONE=
WHATSAPP_RESELLER_PHONE=
WHATSAPP_RETAILER_PHONE=